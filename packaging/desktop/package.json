{
  "name": "nearest-jisho",
  "version": "1.0.0",
  "private": true,
  "description": "Nearest Jisho - offline Japanese-English dictionary",
  "author": "Nostramadeus",
  "homepage": "https://nostramadeus.github.io/nearest-jisho/",
  "license": "MIT",
  "main": "main.cjs",
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.nostramadeus.nearestjisho",
    "productName": "Nearest Jisho",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "package.json"],
    "extraResources": [{ "from": "app", "to": "web" }],
    "publish": null,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "app/icons/icon-512.png",
      "artifactName": "nearest-jisho-${env.NJ_DATE}-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "icon": "app/icons/icon-512.png",
      "executableName": "nearest-jisho",
      "category": "Education",
      "artifactName": "nearest-jisho-${env.NJ_DATE}-linux.${ext}"
    }
  }
}
